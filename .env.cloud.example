# 本番・検証用の接続例。秘密鍵はここへ保存せずデプロイ先の秘密情報管理を使用する。
DB_PROVIDER=drizzle
APP_ENV=staging
CLOUD_SQL_CONNECTION_NAME=your-project:asia-northeast1:your-instance
CLOUD_SQL_DATABASE=your-database
# IAMサービスアカウントの末尾 .gserviceaccount.com を除いたDBユーザー名
CLOUD_SQL_USER=runtime@your-project.iam
CLOUD_SQL_IP_TYPE=PUBLIC
# DATABASE_URL と CLOUD_SQL_CONNECTION_NAME は同時に指定しない。
# FIREBASE_SERVICE_ACCOUNT_KEY は既存の秘密情報設定、またはADCを使用。
