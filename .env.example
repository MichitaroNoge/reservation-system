NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC85sG41Y1prz_DUxkSAmft_Xjl4O6QIVo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reservation-system-7f132.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reservation-system-7f132
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reservation-system-7f132.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=733972352801
NEXT_PUBLIC_FIREBASE_APP_ID=1:733972352801:web:94f77b4e829dbf08793860
NEXT_PUBLIC_USE_DATACONNECT_EMULATOR=false

# Existing deployments default to Data Connect. Set these only for LOCAL development.
# Copy this file to .env.development for both Next.js and the local DB commands.
DB_PROVIDER=drizzle
APP_ENV=development
POSTGRES_DB=reservation_system_dev
POSTGRES_USER=reservation_dev
# Replace with a local-only password, and URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://reservation_dev:replace-with-local-password@127.0.0.1:5433/reservation_system_dev
# Optional: existing Firebase Auth UID to associate the local sample reservations with.
# Seed never creates/updates Firebase Auth users, and never sends email.
DEV_SEED_FIREBASE_UID=
# Isolated local database for the optional multi-connection PostgreSQL integration suite.
# The suite resets ONLY reservation_system_test after explicit confirmation.
TEST_DATABASE_URL=postgresql://reservation_dev:replace-with-local-password@127.0.0.1:5433/reservation_system_test

# Firebase Data Connect / Cloud SQL for PostgreSQL:
FIREBASE_DATACONNECT_LOCATION=asia-northeast1
FIREBASE_DATACONNECT_SERVICE_ID=reservation-system
FIREBASE_DATACONNECT_CONNECTOR=reservation

# Firebase Authentication / Admin authorization:
# Prefer Firebase Auth custom claim `admin: true`.
# Optional fallback for initial setup. Comma-separated admin email addresses.
# This fallback grants admin permission only when the ID token has email_verified=true.
FIREBASE_AUTH_ADMIN_EMAILS=
# Optional JSON string for Firebase Admin SDK service account credentials.
# Leave empty when the runtime has Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Confirmation email delivery:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
# Development-only recipient override. When set, every email is sent only here.
RESEND_TEST_RECIPIENT=
# Comma-separated Resend-verified sender addresses available in the admin UI.
RESEND_ALLOWED_FROM_EMAILS=
# Number of days before the reservation date to send confirmation email.
CONFIRMATION_EMAIL_DAYS_BEFORE=6
# Secret token required by /api/jobs/send-confirmation-emails.
CRON_SECRET=

# Header overwritten by trusted ingress containing a single IP. Leave empty to use a shared unknown-IP bucket.
RATE_LIMIT_TRUSTED_IP_HEADER=
# Google customer login. Native Firebase Google sign-in must remain disabled to prevent automatic email linking.
GOOGLE_OAUTH_CLIENT_ID=
# At least 32 random characters; server only. Never prefix with NEXT_PUBLIC_.
GOOGLE_AUTH_COOKIE_SECRET=

# Anonymous inquiry form HMAC secret (at least 32 random characters; server only)
INQUIRY_FORM_SECRET=
