{
  "name": "reservation-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/test-build/tests/*.test.js",
    "lint": "eslint app components lib scripts tests drizzle.config.ts next.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "dev:local": "tsx scripts/dev.ts",
    "db:up": "tsx scripts/db.ts up",
    "db:stop": "tsx scripts/db.ts stop",
    "db:down": "tsx scripts/db.ts down",
    "db:check": "tsx scripts/db.ts check",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "test:db": "node --conditions=react-server --import tsx --test tests/db/*.test.ts",
    "test:db:postgres": "tsx scripts/test-postgres.ts",
    "auth:revoke": "tsx scripts/auth-sessions.ts revoke",
    "auth:remove-admin": "tsx scripts/auth-sessions.ts remove-admin",
    "db:cloud": "tsx scripts/cloud-db.ts",
    "dataconnect:generate": "tsx scripts/generate-dataconnect.ts"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@hookform/resolvers": "^3.10.0",
    "@next/env": "15.5.27",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@reservation-system/dataconnect": "file:src/generated/dataconnect",
    "@reservation-system/dataconnect-admin": "file:src/generated/dataconnect-admin",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "^7.89.0",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22"
  }
}
